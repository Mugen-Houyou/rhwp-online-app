{
  "name": "rhwp-online-app",
  "version": "1.1.0",
  "description": "RHWP - Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:mac": "electron-builder --mac --arm64",
    "build:mac:dir": "electron-builder --mac --arm64 --dir"
  },
  "author": "Mugen-Houyou",
  "license": "MIT",
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.8.2"
  },
  "build": {
    "appId": "com.rhwp.online-app",
    "productName": "RHWP",
    "files": [
      "main.js",
      "icon.js",
      "src/**",
      "build/icon.png",
      "build/icon-mac.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "ko-KR",
        "en-US"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon-mac.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Mugen-Houyou",
      "repo": "rhwp-online-app"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
